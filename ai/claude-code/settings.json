{
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "theme": "dark-ansi",
  "statusLine": {
    "type": "command",
    "command": "bash \"${XDG_CONFIG_HOME:-$HOME/.config}/claude/plugins/marketplaces/ponytail/hooks/ponytail-statusline.sh\""
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  },
  "hooks": {"SessionStart":[{"matcher":"*","hooks":[{"type":"command","command":"bash '/Users/mubuntu/.config/claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]}
}
