#!/usr/bin/env python3
"""Swap one Herdr pane with a neighbor in either split orientation."""

import json
import os
import subprocess
import sys


def request(*args):
    binary = os.environ.get("HERDR_BIN", os.environ.get("HERDR_BIN_PATH", "herdr"))
    return json.loads(subprocess.check_output([binary, *args], text=True))["result"]


def main():
    pane_id = os.environ.get("HERDR_PANE_ID")
    if not pane_id:
        pane_id = request("pane", "current")["pane"]["pane_id"]
    for direction in ("down", "right", "up", "left"):
        swap = request("pane", "swap", "--pane", pane_id, "--direction", direction)["swap"]
        if swap["changed"]:
            return
        if swap.get("reason") != "no_neighbor":
            raise RuntimeError(f"cannot swap pane: {swap.get('reason', 'unknown reason')}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.CalledProcessError, json.JSONDecodeError, KeyError, RuntimeError) as error:
        sys.exit(f"herdr-smart-swap: {error}")
