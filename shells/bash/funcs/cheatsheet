#!/usr/bin/env bash

cheatsheet() {
  local key_width=13
  local desc_width=35
  local cmd_width=20
  local table_width=$((key_width + desc_width + cmd_width + 2))

  print_separator() {
    printf "%b%-${table_width}s%b\n" "$BRIGHTBLACK" '' "$RESET" | tr ' ' '-'
  }

  # Shell editing bindings below use vi insert mode; Ctrl-A is Herdr-only.
  local bindings=(
    '<A-L>:clear terminal screen:clear'
    '<A-C>:fuzzy change directory:__fzf_cd__'
    '<C-B>:open system monitor:btop'
    '<C-G>:show recent git log:glg -5'
    '<C-R>:search shell command history:__atuin_history'
    '<C-T>:insert files/directories:fzf-file-widget'
    '<C-Y>:paste killed text:yank'
    '<C-U>:delete chars left of cursor:unix-line-discard'
    '<C-I>:complete command or argument (Tab):complete (fzf on ** trigger)'
    '<C-O>:reload shell:exec bash'
    '<C-P>:jump to a frequent directory:zi || true'
    '<C-W>:delete previous word:vi-unix-word-rubout'
    '<C-A>:Herdr prefix (inside Herdr):Herdr prefix ctrl+a'
    '<C-D>:exit on empty prompt:vi-eof-maybe'
    '<C-Z>:suspend process (restart with fg):kill -TSTP <pid>'
    '<C-C>:interrupt process:kill -INT <pid>'
    '<C-N>:open saved editor session:$EDITOR -S Session.vim'
    '<Up>:search history matching input:__atuin_history --shell-up-key-binding'
  )

  local colornames=(
    BLACK RED GREEN YELLOW BLUE MAGENTA CYAN WHITE
    BRIGHTBLACK BRIGHTRED BRIGHTGREEN BRIGHTYELLOW BRIGHTBLUE BRIGHTMAGENTA BRIGHTCYAN BRIGHTWHITE
  )

  local binding i colorname color

  print_separator
  printf "%b%-6s %-35s %-40s%b\n" "$YELLOW$BLUE$GREEN" 'Key' 'Desc' 'Cmd' "$RESET"
  print_separator

  for ((i = 0; i < ${#bindings[@]}; i++)); do
    binding="${bindings[i]}"
    colorname="${colornames[i % ${#colornames[@]}]}"
    color="${!colorname}"
    printf '%b%s%b\n' "$color" "$binding" "$RESET"
  done | awk -F ':' -v k="$key_width" -v d="$desc_width" -v c="$cmd_width" '
    {
      printf "%-*s %-*s %-*s\n", k, $1, d, $2, c, ($3 ? $3 : "")
    }'
}
