#!/usr/bin/env zsh

# Define column widths
local key_width=13
local desc_width=35
local cmd_width=20
local table_width=$((key_width + desc_width + cmd_width + 2)) # +2 for spacing

# Print separator line that matches column layout
print_separator() {
  printf "${BRIGHTBLACK}%-${table_width}s${RESET}\n" '' | tr ' ' '-'
}

print_separator
printf "${YELLOW}%-6s ${BLUE}%-35s ${GREEN}%-40s${RESET}\n" 'Key' 'Desc' 'Cmd'
print_separator

# Shell editing bindings below use vi insert mode; Ctrl-A is Herdr-only.
local bindings=(
  '<A-L>:clear terminal screen:clear'
  '<A-C>:fuzzy change directory:fzf-cd-widget'
  '<C-B>:open system monitor:btop'
  '<C-E>:accept autosuggestion:autosuggest-accept'
  '<C-G>:show recent git log:glg -5'
  '<C-R>:search shell command history:atuin-search-viins'
  '<C-T>:insert files/directories:fzf-file-widget'
  '<C-Y>:run autosuggestion:autosuggest-execute'
  '<C-U>:delete chars left of cursor:vi-kill-line'
  '<C-I>:complete command or argument (Tab):fzf-completion'
  '<C-O>:reload login shell:exec zsh -l'
  '<C-P>:jump to a frequent directory:zi || true'
  '<C-W>:delete previous word:vi-backward-kill-word'
  '<C-A>:Herdr prefix (inside Herdr):Herdr prefix ctrl+a'
  '<C-D>:list choices / exit empty prompt:list-choices'
  '<C-Z>:suspend process (restart with fg):kill -TSTP <pid>'
  '<C-C>:interrupt process:kill -INT <pid>'
  '<C-N>:open saved editor session:$EDITOR -S Session.vim'
  '<Up>:search history matching input:atuin-up-search-viins'
)

# Color names mapped to base16 (you must have these env vars)
local -a colornames=(
  BLACK RED GREEN YELLOW BLUE MAGENTA CYAN WHITE
  BRIGHTBLACK BRIGHTRED BRIGHTGREEN BRIGHTYELLOW BRIGHTBLUE BRIGHTMAGENTA BRIGHTCYAN BRIGHTWHITE
)

local binding i=1

for binding in "${bindings[@]}"; do
  local colorname="${colornames[$((i % 17))]}"
  local color="${(P)colorname}"
  echo -e "${color}${binding}${RESET}"
  ((i++))
done | awk -F ':' -v k="$key_width" -v d="$desc_width" -v c="$cmd_width" '
  {
    printf "%-*s %-*s %-*s\n", k, $1, d, $2, c, ($3 ? $3 : "")
  }'
