#compdef cheatsheet edit-all glg=git-log l=eva list-256 list-colors patch-zsh-autocomplete t take update-icons

case $service in
  eva)
    _eva "$@"
    ;;
  git-log)
    _git "$@"
    ;;
  take|update-icons)
    _arguments '1:directory:_directories'
    ;;
  t)
    if ((CURRENT > 3)); then
      _message 'no more arguments'
    elif [[ $PREFIX == -* ]]; then
      compadd -- -{1..99}
      if ((CURRENT == 2)); then
        compadd -- -h --help
      fi
    elif ((CURRENT == 2)); then
      _directories
    else
      _message 'tree depth (use -1 through -99)'
    fi
    ;;
  patch-zsh-autocomplete)
    _arguments '1:mode:(apply --apply reverse --reverse -R -h --help)'
    ;;
  *)
    _message 'no arguments'
    ;;
esac
