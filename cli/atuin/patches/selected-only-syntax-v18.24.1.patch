+
+#[cfg(all(
+    test,
+    any(target_os = "linux", target_os = "macos", target_os = "windows", target_os = "illumos")
+))]
+mod tests {
+    use std::collections::HashMap;
+
+    use atuin_client::database::DbSearchMode;
+    use rstest::rstest;
+
+    use super::super::engines::db;
+    use super::*;
+
+    #[rstest]
+    fn selected_only_syntax_colors(
+        #[values(false, true)] inverted: bool,
+        #[values(0, 1)] selected: usize,
+        #[values(false, true)] syntax_highlight: bool,
+        #[values(false, true)] alternate_highlight: bool,
+        #[values("", "git", "--flag")] query: &str,
+    ) {
+        let theme = Theme::from_foreground_colors(
+            "test".into(),
+            None,
+            &HashMap::from([(Meaning::Base, "#5c617d".into())]),
+            false,
+        );
+        let entry: History = History::capture()
+            .timestamp(OffsetDateTime::UNIX_EPOCH)
+            .command("git --flag 'hello'")
+            .shell("bash")
+            .cwd("/test")
+            .build()
+            .into();
+        let history = [entry.clone(), entry];
+        let engine: AnySearchEngine = db::Search(DbSearchMode::FullText).into();
+        let columns = [UiColumn::new(UiColumnType::Command)];
+        let area = Rect::new(0, 0, 40, 2);
+        let mut buf = Buffer::empty(area);
+        let mut state = ListState::default();
+        state.select(selected);
+        let now = || OffsetDateTime::UNIX_EPOCH;
+        let list = HistoryList::new(
+            &history,
+            inverted,
+            alternate_highlight,
+            &now,
+            UtcOffset::UTC,
+            " > ",
+            &theme,
+            HistoryHighlighter {
+                engine: &engine,
+                search_input: query,
+            },
+            false,
+            syntax_highlight,
+            &columns,
+        );
+        StatefulWidget::render(list, area, &mut buf, &mut state);
+
+        for row in 0..2_u16 {
+            let selected_row = usize::from(row) == selected;
+            let y = if inverted {
+                row
+            } else {
+                1 - row
+            };
+            let legacy = selected_row && !syntax_highlight && !alternate_highlight;
+            for (byte, syntax_meaning) in [
+                (0_u16, Meaning::SyntaxCommand),
+                (4, Meaning::SyntaxFlag),
+                (11, Meaning::SyntaxString),
+            ] {
+                let matched = (byte == 0 && query == "git") || (byte == 4 && query == "--flag");
+                let meaning = if selected_row && syntax_highlight {
+                    syntax_meaning
+                } else if legacy && matched {
+                    Meaning::AlertWarn
+                } else if legacy {
+                    Meaning::AlertError
+                } else {
+                    Meaning::Base
+                };
+                let cell = &buf[(3 + byte, y)];
+                let expected = Style::from_crossterm(theme.as_style(meaning));
+                assert_eq!(Some(cell.fg), expected.fg);
+                assert_eq!(cell.modifier.contains(Modifier::BOLD), legacy || matched);
+                assert_eq!(
+                    cell.modifier.contains(Modifier::REVERSED),
+                    selected_row && alternate_highlight,
+                );
+            }
+        }
+    }
+}
